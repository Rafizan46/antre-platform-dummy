# Optional overrides for docker-compose.dev.yml: copy this file to .env and edit.
# Local development values only. Never reuse them outside your machine.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev
POSTGRES_DB=antre
POSTGRES_HOST_PORT=35432

REDIS_HOST_PORT=36379

RABBITMQ_DEFAULT_USER=antre
RABBITMQ_DEFAULT_PASS=rabbitmq_dev
RABBITMQ_AMQP_HOST_PORT=35672
RABBITMQ_MANAGEMENT_HOST_PORT=45672

# packages/db scripts and integration tests (pnpm db:*). Not read by Docker Compose.
# Keep host, port, and the postgres user/password in line with the values above.
# Role passwords are the dev placeholders from packages/db/bootstrap.
DATABASE_ADMIN_URL=postgres://postgres:postgres_dev@127.0.0.1:35432/antre
DATABASE_MIGRATOR_URL=postgres://antre_migrator:antre_migrator_dev@127.0.0.1:35432/antre
DATABASE_APP_URL=postgres://antre_app:antre_app_dev@127.0.0.1:35432/antre
DATABASE_PLATFORM_ADMIN_URL=postgres://antre_platform_admin:antre_platform_admin_dev@127.0.0.1:35432/antre

# apps/core-services (Tenant & Auth). Dev-only placeholder (>= 32 characters); production
# reads JWT_SECRET from a Kubernetes Secret and refuses values starting with "dev-only".
JWT_SECRET=dev-only-jwt-secret-not-for-production-0001

# Service token the WhatsApp Channel Service presents on /internal/v1 (>= 32 characters). Dev-only
# placeholder; production reads it from a Kubernetes Secret and refuses values starting with "dev-only".
WA_CHANNEL_SERVICE_TOKEN=dev-only-wa-channel-token-not-for-production-01

# Redis for the booking slot locks (host port matches REDIS_HOST_PORT above). Dev-only value.
REDIS_URL=redis://127.0.0.1:36379

# HMAC secret that signs the QRIS payment callback (>= 32 characters). Dev-only placeholder;
# production reads it from a Kubernetes Secret and refuses values starting with "dev-only".
PAYMENT_CALLBACK_SECRET=dev-only-payment-callback-secret-not-for-prod-01

# Listen address of apps/core-services (pnpm --filter @antre/core-services dev|start).
CORE_SERVICES_HOST=127.0.0.1
CORE_SERVICES_PORT=3000

# RabbitMQ (spec section 7.1): exchange antre.events and the notifications.* queues. Used by
# apps/core-services (publisher) and apps/notification-worker (consumer). Matches the
# RABBITMQ_DEFAULT_* and RABBITMQ_AMQP_HOST_PORT values above; dev-only credentials.
RABBITMQ_URL=amqp://antre:rabbitmq_dev@127.0.0.1:35672
# Management API, used only by pnpm notif:test:integration to create a temporary vhost
# (credentials are taken from RABBITMQ_URL).
RABBITMQ_MANAGEMENT_URL=http://127.0.0.1:45672

# apps/notification-worker. WA_ADAPTER=sandbox (default) sends nothing to Meta and logs each
# message; WA_ADAPTER=meta calls the WhatsApp Cloud API. The META_* values are secrets in
# production (Kubernetes Secret); leave them empty in dev.
WA_ADAPTER=sandbox
WA_TEMPLATE_LANGUAGE=id
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_API_VERSION=v23.0
# Messages handled in parallel per worker, and the retry backoff (spec: 5 s, 25 s, 125 s).
NOTIFICATION_PREFETCH=10
NOTIFICATION_RETRY_DELAYS_MS=5000,25000,125000
# Health (/healthz, /readyz) and metrics (/metrics) listener of the worker.
NOTIFICATION_WORKER_HOST=127.0.0.1
NOTIFICATION_WORKER_PORT=3100

# apps/wa-channel (WA Channel Service, spec section 3.8). WA_VERIFY_TOKEN (hub.verify_token of the
# webhook subscription) and WA_APP_SECRET (Meta App Secret, HMAC key of X-Hub-Signature-256) are
# dev-only placeholders (>= 16 characters); production reads them from a Kubernetes Secret and
# refuses values starting with "dev-only". The service token is WA_CHANNEL_SERVICE_TOKEN above;
# META_WA_PHONE_NUMBER_ID above (when set) filters webhook changes of other numbers.
WA_VERIFY_TOKEN=dev-only-wa-verify-token-0001
WA_APP_SECRET=dev-only-wa-app-secret-not-for-production-01
CORE_SERVICES_URL=http://127.0.0.1:3000
CORE_REQUEST_TIMEOUT_MS=5000
# Session TTL (FR-WA-03: 30 minutes), inbound messages per minute per number (FR-WA-08: 20),
# wa.inbound prefetch, and its retry backoff (spec: 5 s, 25 s, 125 s).
WA_SESSION_TTL_SECONDS=1800
WA_RATE_LIMIT_PER_MINUTE=20
WA_INBOUND_PREFETCH=10
WA_INBOUND_RETRY_DELAYS_MS=5000,25000,125000
# Webhook, /healthz, /readyz, and /metrics listener of the WA Channel Service.
WA_CHANNEL_HOST=127.0.0.1
WA_CHANNEL_PORT=3200
# apps/notification-worker: optional base URL of the QRIS payment simulator; the DP message links
# to <url>/<payment_ref>. Empty = the message says the payment is simulated.
QRIS_SIMULATOR_URL=
