# Variables of docker-compose.prod.yml (prod-like stack). Copy to .env.prod and fill EVERY value:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --wait
# No value below is a real secret. Every CHANGE_ME must be replaced (the services reject secrets
# shorter than 32 characters, and compose refuses empty ones). Generate with:  openssl rand -hex 32
# Keep passwords URL-safe (hex or alphanumeric): they are embedded in connection URLs.
# NODE_ENV=production is fixed in the images: the services refuse secrets starting with "dev-only".

# Image tag of the antre/* images (build: docker compose -f docker-compose.prod.yml build).
ANTRE_TAG=dev

# Host ports (bound to 127.0.0.1). Non-default so they never clash with local PostgreSQL (5432)
# or the dev stack (35432, 36379, 35672, 45672).
GATEWAY_HTTP_PORT=18080
GATEWAY_HTTPS_PORT=18443

# Infrastructure credentials.
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
RABBITMQ_USER=antre
RABBITMQ_PASSWORD=CHANGE_ME

# PostgreSQL role passwords (created by the db-roles job, spec section 6.1).
ANTRE_MIGRATOR_PASSWORD=CHANGE_ME
ANTRE_APP_PASSWORD=CHANGE_ME
ANTRE_PLATFORM_ADMIN_PASSWORD=CHANGE_ME

# Application secrets (each >= 32 characters, except the two WhatsApp webhook secrets >= 16).
JWT_SECRET=CHANGE_ME
WA_CHANNEL_SERVICE_TOKEN=CHANGE_ME
PAYMENT_CALLBACK_SECRET=CHANGE_ME
# Meta App Secret (HMAC key of X-Hub-Signature-256) and the webhook verify token.
WA_APP_SECRET=CHANGE_ME
WA_VERIFY_TOKEN=CHANGE_ME

# WhatsApp delivery: sandbox sends nothing to Meta (messages are logged). For the real Cloud API
# set WA_ADAPTER=meta and fill the two Meta values.
WA_ADAPTER=sandbox
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
# Optional base URL of the QRIS payment simulator (empty = message says the payment is simulated).
QRIS_SIMULATOR_URL=
