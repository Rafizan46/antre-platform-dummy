      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "antre-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 37,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "antre_db_pool_connections{pool=\"app\"}",
          "legendFormat": "{{state}}",
          "datasource": {
            "type": "prometheus",
            "uid": "antre-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 22,
      "title": "Service status",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 23,
      "title": "Targets up (1 = up)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "antre-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 46,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "antre-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "textMode": "value_and_name"
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
