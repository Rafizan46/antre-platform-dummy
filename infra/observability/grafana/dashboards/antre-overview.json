    {
      "id": 19,
      "title": "RabbitMQ: ready / unacked messages",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "antre-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 37,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rabbitmq_detailed_queue_messages_ready{queue=\"notifications.wa\"})",
          "legendFormat": "notifications.wa ready",
          "datasource": {
            "type": "prometheus",
            "uid": "antre-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rabbitmq_queue_messages_ready)",
          "legendFormat": "ready (all)",
          "datasource": {
            "type": "prometheus",
            "uid": "antre-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "sum(rabbitmq_queue_messages_unacked)",
          "legendFormat": "unacked",
          "datasource": {
            "type": "prometheus",
            "uid": "antre-prometheus"
          }
        },
        {
          "refId": "D",
          "expr": "sum(rabbitmq_connections)",
          "legendFormat": "connections",
          "datasource": {
            "type": "prometheus",
            "uid": "antre-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 20,
      "title": "Redis: clients and memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "antre-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 37,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "redis_connected_clients",
          "legendFormat": "clients",
          "datasource": {
            "type": "prometheus",
            "uid": "antre-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "redis_memory_used_bytes / 1024 / 1024",
          "legendFormat": "MiB used",
          "datasource": {
            "type": "prometheus",
            "uid": "antre-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 21,
