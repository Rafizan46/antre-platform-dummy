{
  "uid": "antre-overview",
  "title": "Antre - Overview",
  "tags": ["antre"],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "HTTP (core-services)",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Request rate by route",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "antre-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(antre_http_requests_total[$__rate_interval]))",
          "legendFormat": "{{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "antre-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "p95 latency by route (target 200 ms)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "antre-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(antre_http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "antre-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Error rate (5xx / all)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "antre-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(antre_http_requests_total{status=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(antre_http_requests_total[$__rate_interval])), 1e-9)",
          "legendFormat": "5xx ratio",
          "datasource": {
            "type": "prometheus",
            "uid": "antre-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(antre_http_requests_total{status=~\"4..\"}[$__rate_interval])) / clamp_min(sum(rate(antre_http_requests_total[$__rate_interval])), 1e-9)",
          "legendFormat": "4xx ratio",
          "datasource": {
            "type": "prometheus",
            "uid": "antre-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Gateway (Traefik, all services)",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 6,
      "title": "Request rate by service",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "antre-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(traefik_service_requests_total[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "datasource": {
            "type": "prometheus",
            "uid": "antre-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "p95 latency by service (SSE excluded)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "antre-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(traefik_service_request_duration_seconds_bucket{service!~\"realtime-gateway.*\"}[$__rate_interval])))",
          "legendFormat": "{{service}}",
          "datasource": {
            "type": "prometheus",
            "uid": "antre-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "5xx by service",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "antre-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(traefik_service_requests_total{code=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "datasource": {
            "type": "prometheus",
            "uid": "antre-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "Queue, booking, quota (domain events)",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 10,
      "title": "Tickets created / called / completed / cancelled (per min)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "antre-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event_type) (rate(antre_events_published_total{event_type=~\"queue.ticket.(created|called|completed|cancelled|no_show)\"}[$__rate_interval])) * 60",
          "legendFormat": "{{event_type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "antre-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "Reservations held / confirmed / expired (per min)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "antre-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 19,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event_type) (rate(antre_events_published_total{event_type=~\"booking.reservation.(held|confirmed|expired|cancelled)\"}[$__rate_interval])) * 60",
          "legendFormat": "{{event_type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "antre-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "title": "Quota warnings / exceeded (last 1h)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "antre-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 19,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event_type) (increase(antre_events_published_total{event_type=~\"billing.quota.*\"}[1h]))",
          "legendFormat": "{{event_type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "antre-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "title": "Notifications and WhatsApp",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 14,
      "title": "Notifications sent / retried / skipped (per min)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "antre-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(antre_notifications_sent_total[$__rate_interval])) * 60",
          "legendFormat": "sent",
          "datasource": {
            "type": "prometheus",
            "uid": "antre-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(antre_notifications_retried_total[$__rate_interval])) * 60",
          "legendFormat": "retried",
          "datasource": {
            "type": "prometheus",
            "uid": "antre-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "sum(rate(antre_notifications_skipped_total[$__rate_interval])) * 60",
          "legendFormat": "skipped",
          "datasource": {
            "type": "prometheus",
            "uid": "antre-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 15,
      "title": "Dead-lettered (last 1h) and DLQ depth",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "antre-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 28,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(antre_notifications_dead_lettered_total[1h]))",
          "legendFormat": "notifications DLQ events",
          "datasource": {
            "type": "prometheus",
            "uid": "antre-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(increase(antre_wa_inbound_dead_lettered_total[1h]))",
          "legendFormat": "wa.inbound DLQ events",
          "datasource": {
            "type": "prometheus",
            "uid": "antre-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "sum(rabbitmq_detailed_queue_messages_ready{queue=~\".*dlq\"})",
          "legendFormat": "DLQ messages ready",
          "datasource": {
            "type": "prometheus",
            "uid": "antre-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background"
      }
    },
    {
      "id": 16,
      "title": "WA webhook requests by result",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "antre-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 28,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(antre_wa_webhook_requests_total[$__rate_interval]))",
          "legendFormat": "webhook {{result}}",
          "datasource": {
            "type": "prometheus",
            "uid": "antre-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(antre_wa_untenanted_replies_total[$__rate_interval]))",
          "legendFormat": "replies without tenant",
          "datasource": {
            "type": "prometheus",
            "uid": "antre-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 17,
      "title": "Realtime, broker, Redis, database",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
